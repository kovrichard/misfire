{
  "name": "catalyst",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.15.0",
    "bun": "1.3.13"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev",
    "scan": "REACT_SCAN=true next dev",
    "analyze": "ANALYZE=true next build --webpack",
    "build": "next build",
    "build:checker": "bun build src/lib/checker/entry.ts --outfile public/check.js --minify --target browser --format iife",
    "predev": "bun run build:checker",
    "prebuild": "bun run build:checker",
    "prebuild:standalone": "bun run build:checker",
    "build:standalone": "EXPORT_MODE=standalone next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "test": "bun test --env-file=tests/env.fixture --randomize",
    "test:mutate": "stryker run",
    "test:mutate:diff": "bun .agents/scripts/mutate-diff.ts",
    "lint-staged": "lint-staged",
    "format": "biome format",
    "format-write": "biome format --write",
    "lint": "biome lint",
    "lint-write": "biome lint --write",
    "check": "biome check",
    "check-write": "biome check --write",
    "knip": "knip",
    "jscpd": "jscpd --no-tips",
    "klint": "klint",
    "madge": "madge --circular --extensions ts,tsx --ts-config tsconfig.json --exclude 'prisma/generated' src",
    "lf": "bun .agents/scripts/check-lf.ts",
    "mcp:sync": "bun .agents/scripts/sync-mcp.ts",
    "secretlint": "secretlint \"**/*\"",
    "update:patch": "ncu -u --target patch -p bun && bun i",
    "update:minor": "ncu -u --target minor -p bun && bun i",
    "configure": "bun scripts/configure.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "bun run check"
    ]
  },
  "dependencies": {
    "@microsoft/clarity": "1.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.23.0",
    "next": "16.3.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@commitlint/cli": "21.2.0",
    "@commitlint/config-conventional": "21.2.0",
    "@hughescr/stryker-bun-runner": "1.3.8",
    "@konvert7/klint": "0.33.0",
    "@next/bundle-analyzer": "16.3.0",
    "@opencode-ai/plugin": "1.17.13",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.2",
    "@stryker-mutator/core": "9.6.1",
    "@tailwindcss/postcss": "4.3.2",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.0",
    "@types/prompts": "2.4.9",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "commander": "15.0.0",
    "husky": "9.1.7",
    "jscpd": "5.0.11",
    "knip": "6.24.0",
    "lint-staged": "17.0.8",
    "madge": "8.0.0",
    "npm-check-updates": "22.2.9",
    "postcss": "8.5.16",
    "postcss-load-config": "6.0.1",
    "prompts": "2.4.2",
    "secretlint": "13.0.2",
    "shadcn": "4.13.0",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
