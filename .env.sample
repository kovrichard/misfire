# Private

## General
# The bookmarklet and console snippet are generated from SCHEME + AUTHORITY,
# so these must match the origin the app is actually served from.
SCHEME=http
AUTHORITY=localhost:3000
# ENVIRONMENT=development
# LOG_LEVEL=
# LOG_DRAIN_URL=

## Deploy verification (see the ship-coolify skill)
# COOLIFY_BASE_URL=https://coolify.example.net
# COOLIFY_ACCESS_TOKEN=
# COOLIFY_APP_UUID_STAGE=
# COOLIFY_APP_UUID_PRODUCTION=
